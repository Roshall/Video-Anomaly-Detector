{
    "version": 10,
    "configurePresets": [
        {
            "name": "debug",
            "description": "Debug Config",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "release",
            "description": "Release Config",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "cleanFirst": false,
            "jobs": 8
        },
        {
            "name": "release",
            "configurePreset": "release",
            "cleanFirst": false,
            "jobs": 0
        }
    ]
}
